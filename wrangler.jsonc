{
  // Standard Wrangler project — runs unchanged on `wrangler dev` (local),
  // Cloudflare, or self-hosted via `celld deploy . --bucket s3://...`.
  "name": "canvas",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "TILE", "class_name": "Tile" },
      { "name": "USER", "class_name": "User" }
    ]
  },
  // v1 created a Canvas class that has since been removed; celld doesn't
  // support deleted_sqlite_classes yet, so the tag stays as history.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Canvas"] },
    { "tag": "v2", "new_sqlite_classes": ["Tile", "User"] }
  ]
}
